# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=afu_rtm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=afu_rtm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://afu_rtm:change_me@postgres:5432/afu_rtm

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- HEMIS API ---
API_HEMIS_TOKEN=
API_HEMIS_URL=https://student.alfraganusuniversity.uz

# --- Admin bootstrap (backend/scripts/seed_admin.py) ---
