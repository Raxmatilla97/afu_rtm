# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres ---
POSTGRES_USER=afu_rtm
POSTGRES_PASSWORD=change_me
POSTGRES_DB=afu_rtm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://afu_rtm:change_me@postgres:5432/afu_rtm

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- HEMIS API ---
API_HEMIS_TOKEN=
API_HEMIS_URL=https://student.alfraganusuniversity.uz

# --- Admin bootstrap (backend/scripts/seed_admin.py) ---
ADMIN_EMAIL=admin@rtm.afu.uz
ADMIN_PASSWORD=change_me

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
SESSION_COOKIE_NAME=afu_rtm_session
SESSION_TTL_DAYS=30

# --- Telegram bot (create via @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- HEMIS OAuth2 (per-user employee login; separate from the API_HEMIS_TOKEN bulk sync) ---
# Registered redirect URI must match EXACTLY, including scheme and trailing characters.
EMPLOYEE_CLIENT_ID=
EMPLOYEE_CLIENT_SECRET=
EMPLOYEE_REDIRECT_URI=https://rtm.afu.uz/oauth/callback
EMPLOYEE_URL_AUTHORIZE=https://hemis.alfraganusuniversity.uz/oauth/authorize
EMPLOYEE_URL_ACCESS_TOKEN=https://hemis.alfraganusuniversity.uz/oauth/access-token
EMPLOYEE_URL_RESOURCE_OWNER_DETAILS=https://hemis.alfraganusuniversity.uz/oauth/api/user?fields=id,uuid,type,name,login,picture,email,university_id,phone,specialty
# Leave empty to omit the scope param entirely.
EMPLOYEE_OAUTH_SCOPE=
OAUTH_STATE_TTL_SECONDS=3600
# Logs the full userinfo payload on unmatched logins. Turn off once matching is proven.
OAUTH_DEBUG_LOG_USERINFO=true
OAUTH_ALLOWED_USER_TYPES=employee

# --- Port exposed to BunkerWeb ---
# BunkerWeb (on the aaPanel server) forwards ALL of rtm.afu.uz to this one port. The
# frontend container's nginx then splits /api, /oauth, /media and /health off to the
# backend internally, so BunkerWeb needs no per-path rules.
# Firewall it so ONLY BunkerWeb can reach it; direct access bypasses the WAF.
#   BunkerWeb runs directly on the host  -> BIND_ADDRESS=127.0.0.1 (tightest)
#   BunkerWeb runs in its own container  -> BIND_ADDRESS=0.0.0.0, and block 18080 from the
#     public interface in the firewall. A container cannot reach the host's 127.0.0.1, so
#     binding to loopback would make the site unreachable.
FRONTEND_HTTP_PORT=18080
BIND_ADDRESS=0.0.0.0

# --- Backend / deployment ---
PUBLIC_BASE_URL=https://rtm.afu.uz
COOKIE_SECURE=true
BACKEND_CORS_ORIGINS=https://rtm.afu.uz
STORAGE_ROOT=/app/storage

# --- Frontend ---
# Empty = same-origin relative API calls. Consumed at BUILD time (compose build arg).
VITE_API_BASE_URL=

# --- Outgoing mail: password reset letters only ---
# Leave SMTP_HOST empty to disable sending. The reset flow then tells the user to
# contact RTM instead of pretending a letter went out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RTM Murojaatlar <no-reply@afu.uz>
# true for STARTTLS on port 587, false for implicit TLS on 465
SMTP_STARTTLS=true
PASSWORD_RESET_TTL_MINUTES=60
