# Internal router only — plain HTTP on :80, no TLS and no ACME.
#
# Dokploy's Traefik terminates HTTPS for rtm.afu.uz and forwards here, so Caddy must NOT
# try to obtain its own certificate: two ACME clients racing for the same domain is how
# you end up with neither getting one. Point the Dokploy domain at this service on port 80.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	# Backend-owned paths. `handle` blocks are mutually exclusive and matched
	# most-specific-first, so /oauth/callback reaches the backend even though the SPA
	# owns "/". The HEMIS redirect URI is a ROOT path, which is what makes this necessary.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /oauth/* {
		reverse_proxy backend:8000
	}
	handle /media/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	# Everything else: the built SPA. Its own nginx does the history-API fallback.
	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
	}
}
